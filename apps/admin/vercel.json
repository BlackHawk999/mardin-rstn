{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/api/:path*", "destination": "https://douglas-economics-falls-veterans.trycloudflare.com/api/:path*" },
    { "source": "/uploads/:path*", "destination": "https://douglas-economics-falls-veterans.trycloudflare.com/uploads/:path*" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
