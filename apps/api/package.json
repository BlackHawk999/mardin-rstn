    "@rt/shared": "workspace:*",
    "dotenv": "^16.6.1",
    "fastify": "^5.12.5",
    "fastify-plugin": "^5.1.0",
    "grammy": "^1.46.0",
    "sharp": "^0.35.4",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.20.4",
    "pino-pretty": "^13.1.3",
    "prisma": "^6.19.3",
