# ---- apps/api ----
BOT_TOKEN=123456:ABC-DEF
DATABASE_URL="file:./dev.db"
PORT=3000
# Public HTTPS URL of the mini app (ngrok / cloudflare tunnel in dev)
MINIAPP_URL=https://example.trycloudflare.com
# Chat id that receives new orders (restaurant manager / group). Optional.
ADMIN_CHAT_ID=
# Allow "Authorization: dev <telegramId>" header instead of real initData. Never enable in production.
ALLOW_DEV_AUTH=true
# false = don't start the bot (local dev while the server runs it: one bot token can't be polled twice)
BOT_POLLING=true
# Admin panel credentials (password login). Empty password disables it.
ADMIN_LOGIN=admin
ADMIN_PASSWORD=change-me
# Secret for admin session tokens (defaults to a hash of BOT_TOKEN)
ADMIN_TOKEN_SECRET=
# Public API origin for uploaded image URLs; empty = relative /uploads/... behind a proxy
PUBLIC_API_URL=
# Yandex Maps key ("JavaScript API and HTTP Geocoder"): https://developer.tech.yandex.ru/services/
YANDEX_MAPS_KEY=

# ---- apps/miniapp ----
# Leave empty in dev: Vite proxies /api to the API (works from a phone on the same Wi-Fi and through tunnels).
VITE_API_URL=
# Used only when the app is opened outside Telegram in dev (see ALLOW_DEV_AUTH)
VITE_DEV_TELEGRAM_ID=100000001
# Same Yandex key as above (the JS API is loaded in the browser)
VITE_YANDEX_MAPS_KEY=
